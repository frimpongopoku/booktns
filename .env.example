# Environment variables declared in this file are NOT automatically loaded by Prisma —
# prisma.config.ts loads them via `dotenv/config`.

# Local Postgres — pick your own values (e.g. `openssl rand -base64 18` for the
# password), then `docker compose up -d`. docker-compose.yml reads the three
# POSTGRES_* vars directly; DATABASE_URL must encode the same values.
POSTGRES_USER="booktns"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="booktns_dev"
DATABASE_URL="postgresql://booktns:change-me@localhost:5434/booktns_dev?schema=public"

# App
# Local dev ports are 2665 (frontend) and 2666 (API) — mnemonic: BOOK on a
# phone keypad. Deliberately away from the crowded defaults: 3000 is Next's
# own and half the JS ecosystem's, 4000/8000/8080 are widely used, and on
# macOS 5000 and 7000 are taken by the AirPlay Receiver. `npm run dev` pins
# 2665 via the package.json script, so it can't drift onto whatever is free.
NEXT_PUBLIC_APP_URL="http://localhost:2665"

# The NestJS API (backend/ — deployed separately to Railway). Public because
# browser components call it directly; it is a URL, not a secret. The API's
# CORS is permissive by design (see backend/.env.example) since it never
# relies on cross-origin cookies, so this just needs to be the API's real
# reachable URL in each environment — e.g. the Railway service URL in
# production.
NEXT_PUBLIC_API_URL="http://localhost:2666"

# Firebase client config (safe to expose) — Firebase console → Project settings → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Firebase Admin SDK (server-only, secret) — Project settings → Service accounts → Generate new private key
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Session JWT signing secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=

# Resend (email — booking-request/confirmed emails to the customer and
# new-booking notifications to vendor Owner/Management staff). EMAIL_FROM's
# domain must be verified in Resend's dashboard — a subdomain you've verified
# there (e.g. notifications.yourdomain.com) works, but its parent apex domain
# does NOT count as verified just because the subdomain is; Resend checks the
# exact sending domain.
RESEND_API_KEY=
EMAIL_FROM="Booktns <bookings@notifications.booktns.com>"

# Africa's Talking (SMS — booking-request/confirmed texts to the customer and
# new-booking alerts to vendor Owner/Management staff, alongside the existing
# email sends). Ghana requires an approved alphanumeric Sender ID (NCA
# registration) before commercial sends — AFRICAS_TALKING_SENDER_ID is
# optional and safe to leave blank while testing (falls back to a shared ID),
# but should be set once registered. Get credentials at africastalking.com.
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_SENDER_ID=

# Sentry (error tracking) — create a free project at sentry.io, then:
# Settings → Projects → <your project> → Client Keys (DSN). Note it's a
# PROJECT setting, not an org one — it isn't in the top-level Settings list.
# Both DSN values below are the same string; NEXT_PUBLIC_ is exposed to the
# browser (a DSN is write-only and safe to expose), the other stays
# server-only by convention.
# SENTRY_ORG/SENTRY_PROJECT/SENTRY_AUTH_TOKEN are only needed for source map
# upload at build time — safe to leave blank, the build just skips that step.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Analytics (PostHog). Leave NEXT_PUBLIC_POSTHOG_KEY blank to disable
# analytics entirely — which is what you want in local development, so dev
# traffic doesn't land in production numbers. HOST is your PostHog region's
# ingestion host (https://us.i.posthog.com or https://eu.i.posthog.com);
# next.config.ts reverse-proxies it under /ingest so content blockers don't
# drop the requests.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Private storage for identity documents (vendor verification). A SEPARATE
# R2 bucket on the same account — no public access, no custom domain. Leave
# blank in dev and ID scans fall back to local disk with a loud warning;
# this MUST be set in production.
CLOUDFLARE_R2_PRIVATE_BUCKET=

# Vendors excluded from superadmin platform stats (comma-separated slugs).
# Defaults to the seeded demo vendor.
DEMO_VENDOR_SLUGS=

# Support (Settings → Help & Support tab emails this inbox when a vendor
# staff member submits a message)
# Also receives the "Give feedback" messages from the dashboard
# sidebar, the storefront footer and the landing page footer
# (POST /api/feedback). Leave blank and that button returns a clear
# "not set up" error rather than silently dropping messages.
SUPPORT_INBOX_EMAIL=

# Cloudflare R2 (file storage — product photos, vendor media library)
# Dashboard → R2 Object Storage → create a bucket → bucket Settings → enable
# public access for CLOUDFLARE_R2_PUBLIC_URL, then Manage R2 API Tokens →
# create a token with Object Read & Write for the other four values.
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_PUBLIC_URL=

# Custom domains (vendor storefronts on their own domain — see lib/domains/).
# Hosting is still undecided, so all of these are optional and safe to leave
# blank in dev: with nothing set, lib/domains/factory.ts falls back to
# ManualDnsDomainProvider (real DNS lookups, no external API). Set
# PLATFORM_APEX_IP/PLATFORM_CNAME_TARGET once you know what vendors should
# point their DNS at — even in dev-fallback mode these drive both the DNS
# instructions shown in Settings and what the dev-mode checker compares
# against; leaving them blank makes that tab show "still finishing setup"
# instead of broken instructions.
PLATFORM_APEX_IP=
PLATFORM_CNAME_TARGET=

# Vercel Domains API (prod provider) — only needed once hosting is decided
# and is Vercel. Leave blank to stay on the dev-mode DNS provider.
# VERCEL_API_TOKEN: Vercel dashboard → Settings → Tokens → Create.
# VERCEL_PROJECT_ID: Project → Settings → General → Project ID.
# VERCEL_TEAM_ID: only needed if the project lives under a team, not a
# personal account — Team Settings → General → Team ID. Safe to leave blank.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
