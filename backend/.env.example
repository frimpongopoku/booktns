# ---------------------------------------------------------------------------
# Booktns API (NestJS) — deployed to Railway, separate from the Next.js
# frontend on Vercel. The frontend has its own .env.example one level up.
# ---------------------------------------------------------------------------

# Railway injects PORT automatically and config.ts reads it first; 2666 is
# only the local default. Ports are 2665 (frontend) / 2666 (API) —
# mnemonic: BOOK on a phone keypad, and clear of the crowded 3000/4000/
# 5000/8000 ranges (macOS AirPlay holds 5000 and 7000).
PORT=2666

# Railway Postgres. Use the PUBLIC connection string if the frontend or your
# laptop needs to reach it too — *.railway.internal only resolves inside
# Railway's private network.
DATABASE_URL=

# MUST be byte-identical to the frontend's JWT_SECRET. Both sign and verify
# the same session cookie; a mismatch logs everyone out with no error.
JWT_SECRET=

# --- Auth: this API is COOKIE-BLIND ----------------------------------------
#
# It never sets or reads a cookie. /auth/session returns a JWT in the response
# body; every guarded request presents it as `Authorization: Bearer <token>`.
# The Next.js app owns the cookie and its BFF proxy attaches the header.
#
# That is why there is no CORS_ORIGINS, COOKIE_DOMAIN or COOKIE_SAMESITE here.
# CORS is permissive-origin with credentials OFF — safe because nothing
# depends on a cross-origin cookie, and necessary because an origin allowlist
# could never contain every vendor's own custom domain.

# MUST be byte-identical to the frontend's JWT_SECRET. The frontend stores the
# token this API signs; a mismatch logs everyone out with no error anywhere.
# (Already set above as JWT_SECRET.)

# Separate secret for the platform console's token space. Different secrets
# mean a vendor token fails signature verification as a superadmin token and
# vice versa — a stronger guarantee than both guards remembering to check a
# `kind` field. Falls back to JWT_SECRET if unset; set it in production.
SUPERADMIN_JWT_SECRET=

# Absolute URL of the frontend. Used to build links inside emails and PDFs —
# a booking permalink is useless if it points at the API host.
PUBLIC_APP_URL=http://localhost:2665

# --- Firebase (Google sign-in verification) --------------------------------
# Only the Admin SDK lives here; the browser-side keys stay on the frontend.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Email / SMS -----------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Booktns <bookings@notifications.booktns.com>"
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_SENDER_ID=

# Also receives "Give feedback" messages. Falls back to support@biibisoft.com
# when unset, so nothing is silently dropped.
SUPPORT_INBOX_EMAIL=

# --- Storage ---------------------------------------------------------------
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_PUBLIC_URL=

# REQUIRED IN PRODUCTION. Without it, government ID scans fall back to local
# disk — which a container restart destroys.
CLOUDFLARE_R2_PRIVATE_BUCKET=

# --- Optional --------------------------------------------------------------
DEMO_VENDOR_SLUGS=
PLATFORM_APEX_IP=
PLATFORM_CNAME_TARGET=
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
