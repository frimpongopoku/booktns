# ---------------------------------------------------------------------------
# Booktns API (NestJS) — deployed to Railway, separate from the Next.js
# frontend on Vercel. The frontend has its own .env.example one level up.
# ---------------------------------------------------------------------------

# Railway injects PORT automatically; 4000 is the local default.
PORT=4000

# Railway Postgres. Use the PUBLIC connection string if the frontend or your
# laptop needs to reach it too — *.railway.internal only resolves inside
# Railway's private network.
DATABASE_URL=

# MUST be byte-identical to the frontend's JWT_SECRET. Both sign and verify
# the same session cookie; a mismatch logs everyone out with no error.
JWT_SECRET=

# --- Cross-origin cookies: the single most consequential setting here -------
#
# The browser only sends the session cookie to this API if the origin is
# allowed AND the cookie is scoped to reach it.
#
# Comma-separated list of frontend origins allowed to call with credentials.
# No wildcard: browsers reject "*" when credentials are involved.
CORS_ORIGINS=http://localhost:3000
#
# Preferred — API on a subdomain of the same apex as the frontend
# (app.booktns.com + api.booktns.com):
#   COOKIE_DOMAIN=.booktns.com
#   COOKIE_SAMESITE=lax
#
# Fallback — unrelated hosts (booktns.vercel.app + *.up.railway.app). This
# makes the session a THIRD-PARTY cookie: Safari's ITP blocks it outright and
# Chrome is phasing it out, so real users will silently lose their sessions.
# Treat as staging-only.
#   COOKIE_SAMESITE=none
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# Absolute URL of the frontend. Used to build links inside emails and PDFs —
# a booking permalink is useless if it points at the API host.
PUBLIC_APP_URL=http://localhost:3000

# --- Firebase (Google sign-in verification) --------------------------------
# Only the Admin SDK lives here; the browser-side keys stay on the frontend.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Email / SMS -----------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Booktns <bookings@notifications.booktns.com>"
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_SENDER_ID=

# Also receives "Give feedback" messages. Falls back to support@biibisoft.com
# when unset, so nothing is silently dropped.
SUPPORT_INBOX_EMAIL=

# --- Storage ---------------------------------------------------------------
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_PUBLIC_URL=

# REQUIRED IN PRODUCTION. Without it, government ID scans fall back to local
# disk — which a container restart destroys.
CLOUDFLARE_R2_PRIVATE_BUCKET=

# --- Optional --------------------------------------------------------------
DEMO_VENDOR_SLUGS=
PLATFORM_APEX_IP=
PLATFORM_CNAME_TARGET=
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
